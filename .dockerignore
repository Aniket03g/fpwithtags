# Git files
.git
.gitignore

# Editor files
.vscode
.idea
*.swp
*.swo

# Build artifacts
**/bin
**/obj
**/node_modules
**/dist
**/*.exe
**/*.dll
**/*.so
**/*.dylib

# Logs
**/*.log
**/logs

# Local development files
.env
.env.local
.env.development
.env.test
.env.production

# Docker files (to avoid recursive copying)
Dockerfile
docker-compose.yml
.dockerignore

# Database files (these will be mounted as volumes)
**/*.db
**/*.sqlite
**/*.sqlite3

# Other unnecessary files
**/README.md
**/LICENSE
**/.DS_Store
