# GitHub Personal Access Token (required)
# Get from: https://github.com/settings/tokens
# Required scopes: repo (for private repos), public_repo (for public only)
GITHUB_PERSONAL_ACCESS_TOKEN=

# MCP Bridge API Key (required)
# Used to authenticate requests to the bridge
# Should be a secure random string
MCP_BRIDGE_API_KEY=

# Optional configuration

# Port to bind the bridge service (default: 8089)
# MCP_BRIDGE_PORT=8089

# Timeout for MCP analysis in seconds (default: 90s)
# MCP_ANALYSIS_TIMEOUT=90s

# MCP Docker container image (default: ghcr.io/github/github-mcp-server)
# MCP_CONTAINER_IMAGE=ghcr.io/github/github-mcp-server
